# Database Neon — HARUS terpisah dari finance-dashboard.
# Dua aplikasi, dua database; keduanya hanya terhubung lewat kontrak API.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with: npx auth secret"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email pemilik ruang. Sejak Fase 2 ini BUKAN pemblokir login — pendaftaran
# dibatasi undangan — melainkan penanda peran: hanya pemilik yang melihat
# modul Finance sync dan Legacy, dan hanya pemilik yang bisa membuat undangan.
OWNER_EMAIL="you@example.com"

# Fase 3 — sync read-only dari finance-dashboard.
# FINANCE_SYNC_TOKEN harus SAMA dengan SYNC_TOKEN di finance-dashboard.
FINANCE_API_URL="https://finance.example.com"
FINANCE_SYNC_TOKEN=""

# Melindungi /api/cron/*. Route itu dikecualikan dari proxy auth karena
# dipanggil mesin, jadi tokennya adalah satu-satunya gerbang.
# Generate: openssl rand -base64 32
CRON_SECRET=""

# Vault Legacy — master key pembungkus data key tiap item.
# Generate: openssl rand -base64 32
# WAJIB pindah ke KMS sebelum dead man's switch diaktifkan
# (rencana-fase-5-legacy.md §5).
LEGACY_MASTER_KEY=""

# URL publik aplikasi. Dipakai NextAuth dan tautan di dalam email notifikasi.
# Tanpa ini, tautan "keluarkan semua perangkat" di email menunjuk localhost.
AUTH_URL="https://second-brain.example.com"

# Notifikasi keamanan (login perangkat baru, sesi dicabut, data diunduh).
# Opsional: tanpa ini kejadiannya tetap tercatat di log, hanya tidak dikirim.
#
# RESEND_API_KEY diambil dari dashboard resend.com (API Keys > Create),
# bentuknya "re_...". Gratis sampai 3.000 email/bulan.
#
# NOTIFY_FROM:
#   - Tanpa domain sendiri: "onboarding@resend.dev" — hanya bisa mengirim ke
#     alamat email yang dipakai mendaftar Resend. Cukup untuk notifikasi
#     pemilik, TIDAK cukup kalau user undangan juga perlu diberi tahu.
#   - Dengan domain sendiri: verifikasi domainnya di Resend, lalu pakai
#     "Second Brain <noreply@domainmu.com>" dan bisa kirim ke siapa pun.
RESEND_API_KEY=""
NOTIFY_FROM="onboarding@resend.dev"
