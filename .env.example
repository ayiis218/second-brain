# Database Neon — HARUS terpisah dari finance-dashboard.
# Dua aplikasi, dua database; keduanya hanya terhubung lewat kontrak API.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with: npx auth secret"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Batasi login hanya untuk email ini (single-user app)
ALLOWED_EMAIL="you@example.com"

