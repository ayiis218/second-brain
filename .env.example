# Database Neon — HARUS terpisah dari finance-dashboard.
# Dua aplikasi, dua database; keduanya hanya terhubung lewat kontrak API.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with: npx auth secret"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email pemilik ruang. Sejak Fase 2 ini BUKAN pemblokir login — pendaftaran
# dibatasi undangan — melainkan penanda peran: hanya pemilik yang melihat
# modul Finance sync dan Legacy, dan hanya pemilik yang bisa membuat undangan.
OWNER_EMAIL="you@example.com"

# Fase 3 (belum dipakai): koneksi ke endpoint export finance-dashboard
# FINANCE_API_URL="https://finance.example.com"
# FINANCE_SYNC_TOKEN=""
