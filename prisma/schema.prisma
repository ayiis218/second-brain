generator client {
  provider = "prisma-client-js"
}

// Prisma 7: connection string untuk Migrate hidup di prisma.config.ts,
// dan runtime memakai driver adapter di src/lib/prisma.ts.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// NextAuth (pola sama dengan finance-dashboard)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Core: entries, tags, links
// ---------------------------------------------------------------------------

enum EntrySource {
  NATIVE
  FINANCE
}

/// Tabel pusat semua data. `content` divalidasi Zod per `type`
/// lewat src/lib/entries/schemas.ts — jangan pernah tulis langsung.
model Entry {
  id         String      @id @default(cuid())
  /// 'journal' | 'task' | 'note' | ... — sengaja String, bukan enum:
  /// menambah tipe entry baru tidak boleh butuh migrasi.
  type       String
  title      String?
  content    Json
  /// Kapan peristiwanya terjadi (bisa backdate), bukan kapan barisnya ditulis.
  occurredAt DateTime
  source     EntrySource @default(NATIVE)
  /// Id di sistem asal, hanya terisi untuk data hasil sync (Fase 3).
  sourceId   String?

  createdAt DateTime  @default(now())
  /// Dipelihara trigger `entry_before_write`, bukan Prisma.
  updatedAt DateTime  @default(now())
  deletedAt DateTime?

  /// Diisi trigger, dibaca lewat $queryRaw. Prisma tidak bisa menyentuhnya.
  searchVector Unsupported("tsvector")?

  tags      EntryTag[]
  linksFrom EntryLink[] @relation("LinkFrom")
  linksTo   EntryLink[] @relation("LinkTo")

  /// Kunci idempotensi sync. Aman untuk entry native: Postgres
  /// memperlakukan NULL sebagai saling berbeda.
  @@unique([source, sourceId])
  @@index([occurredAt(sort: Desc), id])
  @@index([type, occurredAt(sort: Desc)])
  @@index([deletedAt])
}

model Tag {
  id    String  @id @default(cuid())
  /// Lowercase ternormalisasi — mencegah 'Kerja'/'kerja' jadi dua tag.
  name  String  @unique
  /// Tampilan apa adanya sesuai yang diketik user.
  label String
  color String?

  createdAt DateTime   @default(now())
  entries   EntryTag[]
}

model EntryTag {
  entryId String
  tagId   String
  entry   Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([entryId, tagId])
  @@index([tagId])
}

model EntryLink {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  kind      String   @default("related")
  createdAt DateTime @default(now())

  from Entry @relation("LinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Entry @relation("LinkTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, kind])
  @@index([toId])
}
