generator client {
  provider = "prisma-client-js"
}

// Prisma 7: connection string untuk Migrate hidup di prisma.config.ts,
// dan runtime memakai driver adapter di src/lib/prisma.ts.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// NextAuth (pola sama dengan finance-dashboard)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  entries    Entry[]
  tags       Tag[]
  entryLinks EntryLink[]

  /// Token yang diterbitkan SEBELUM waktu ini ditolak. Menaikkannya
  /// memaksa seluruh perangkat login ulang — inilah cara memutus akses
  /// HP yang hilang, karena JWT sendiri tidak bisa dicabut.
  sessionsValidAfter DateTime?

  legacyItems     LegacyItem[]
  knownDevices    KnownDevice[]
  invitesCreated  Invite[] @relation("InviteCreator")
  invitesRedeemed Invite[] @relation("InviteRedeemer")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Core: entries, tags, links
// ---------------------------------------------------------------------------

enum EntrySource {
  NATIVE
  FINANCE
}

/// Tabel pusat semua data. `content` divalidasi Zod per `type`
/// lewat src/lib/entries/schemas.ts — jangan pernah tulis langsung.
model Entry {
  id         String      @id @default(cuid())
  /// Pemilik baris. Setiap query WAJIB terfilter kolom ini —
  /// lihat src/lib/entries/repository.ts dan src/lib/prisma.ts.
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 'journal' | 'task' | 'note' | ... — sengaja String, bukan enum:
  /// menambah tipe entry baru tidak boleh butuh migrasi.
  type       String
  title      String?
  content    Json
  /// Kapan peristiwanya terjadi (bisa backdate), bukan kapan barisnya ditulis.
  occurredAt DateTime
  source     EntrySource @default(NATIVE)
  /// Id di sistem asal, hanya terisi untuk data hasil sync (Fase 3).
  sourceId   String?

  createdAt DateTime  @default(now())
  /// Dipelihara trigger `entry_before_write`, bukan Prisma.
  updatedAt DateTime  @default(now())
  deletedAt DateTime?

  /// Diisi trigger, dibaca lewat $queryRaw. Prisma tidak bisa menyentuhnya.
  searchVector Unsupported("tsvector")?

  tags      EntryTag[]
  linksFrom EntryLink[] @relation("LinkFrom")
  linksTo   EntryLink[] @relation("LinkTo")

  /// Kunci idempotensi sync, di-scope per user. Aman untuk entry native:
  /// Postgres memperlakukan NULL sebagai saling berbeda.
  @@unique([userId, source, sourceId])
  /// Semua index diawali userId — tanpa itu setiap query memindai
  /// baris milik seluruh user.
  @@index([userId, occurredAt(sort: Desc), id])
  @@index([userId, type, occurredAt(sort: Desc)])
  @@index([userId, deletedAt])
}

model Tag {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Lowercase ternormalisasi — mencegah 'Kerja'/'kerja' jadi dua tag.
  name   String
  /// Tampilan apa adanya sesuai yang diketik user.
  label  String
  color  String?

  createdAt DateTime   @default(now())
  entries   EntryTag[]

  /// Unik PER USER, bukan global. Kalau global, tag 'kerja' milik satu user
  /// memblokir semua user lain memakai nama yang sama.
  @@unique([userId, name])
}

model EntryTag {
  entryId String
  tagId   String
  entry   Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([entryId, tagId])
  @@index([tagId])
}

model EntryLink {
  id     String @id @default(cuid())
  /// Denormalisasi yang disengaja: bisa diturunkan dari `from`/`to`, tapi
  /// kolom sendiri membuat scoping seragam untuk semua model dan mencegah
  /// link antar-user secara struktural.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fromId    String
  toId      String
  kind      String   @default("related")
  createdAt DateTime @default(now())

  from Entry @relation("LinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Entry @relation("LinkTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, kind])
  @@index([toId])
  @@index([userId])
}

/// Pendaftaran hanya lewat undangan yang dibuat pemilik.
/// Tidak ada pendaftaran terbuka.
model Invite {
  id   String  @id @default(cuid())
  /// Acak, bukan cuid berurutan — kode ini adalah kredensial.
  code String  @unique
  /// Opsional: mengunci undangan ke satu alamat email.
  email String?

  createdById String
  createdBy   User   @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)

  usedById String?
  usedBy   User?     @relation("InviteRedeemer", fields: [usedById], references: [id], onDelete: SetNull)
  usedAt   DateTime?

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
  @@index([createdById])
}

/// Posisi sinkronisasi dari sistem luar. Satu baris per sumber.
///
/// Sengaja TIDAK ber-userId: finance-dashboard sendiri single-user, jadi
/// seluruh transaksi hasil sync selalu milik pemilik ruang ini
/// (rencana-aplikasi-second-brain.md §6.3).
model SyncState {
  source    String    @id
  txCursor  String?
  delCursor String?
  lastRunAt DateTime?
  lastError String?
  updatedAt DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Legacy — gudang informasi untuk ahli waris (Fase 5A)
//
// TABEL SENDIRI, BUKAN Entry. Trigger `entry_before_write` mengindeks title
// dan content->>'body' ke searchVector dalam teks biasa; menyimpan nomor
// rekening di sana akan membocorkannya lewat satu dump database, seberapa
// pun rapi enkripsi di kolom lain. Lihat rencana-fase-5-legacy.md §2.
// ---------------------------------------------------------------------------

enum LegacyCategory {
  KEUANGAN
  INVESTASI
  ASET
  DOKUMEN
  AKSES_DIGITAL
  UTANG_PIUTANG
  KONTAK
  INSTRUKSI
}

model LegacyItem {
  id       String         @id @default(cuid())
  userId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category LegacyCategory

  /// Seluruh isi item ada di dalam blob ini. TIDAK ADA field plaintext
  /// selain category — termasuk judulnya.
  ciphertext Bytes
  iv         Bytes
  authTag    Bytes
  /// Data key item ini, terbungkus master key.
  wrappedKey Bytes
  /// Versi master key yang membungkus. Memungkinkan pindah ke KMS nanti
  /// dengan membungkus ulang data key, bukan mengenkripsi ulang isinya.
  keyVersion Int    @default(1)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments LegacyAttachment[]

  @@index([userId, category, sortOrder])
}

model LegacyAttachment {
  id     String     @id @default(cuid())
  itemId String
  item   LegacyItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// Kunci objek di R2. Nama berkas asli ada di dalam ciphertext item,
  /// bukan di sini — nama berkas sering membocorkan isinya.
  objectKey  String
  mimeType   String
  sizeBytes  Int
  iv         Bytes
  authTag    Bytes
  wrappedKey Bytes
  keyVersion Int    @default(1)
  createdAt  DateTime @default(now())

  @@index([itemId])
}

/// Foto posisi keuangan dari finance-dashboard. Satu baris per sumber.
///
/// BUKAN Entry: Entry adalah peristiwa pada satu waktu, snapshot adalah
/// keadaan terkini yang selalu ditimpa. Memaksakannya jadi Entry akan
/// mengotori timeline dengan ratusan baris yang tidak berarti kronologis.
model FinanceSnapshot {
  source     String    @id
  payload    Json
  capturedAt DateTime
  fetchedAt  DateTime  @default(now())
  lastError  String?
}

/// Perangkat yang pernah dipakai login. Dicatat supaya login dari perangkat
/// BARU bisa diberitahukan — tanpa ini, kebocoran bisa berlangsung sebulan
/// tanpa pemiliknya sadar.
model KnownDevice {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Hash dari user-agent. Bukan sidik jari yang kuat, tapi cukup untuk
  /// membedakan "browser yang sama seperti kemarin" dari "browser baru".
  fingerprint String
  label       String
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([userId, fingerprint])
  @@index([userId, lastSeenAt])
}
