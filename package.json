{
  "name": "second-brain",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "prisma generate && next build",
    "start": "next start -p 3001",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:gates": "node scripts/check-gates.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:http": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/apply-migration.mjs",
    "db:sql": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/sql.mjs",
    "db:studio": "prisma studio",
    "db:verify:isolation": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/verify-isolation.mjs",
    "db:verify:phase2": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/verify-phase2.mjs",
    "db:import": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/import.mjs",
    "db:verify:export": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/verify-export-import.mjs",
    "db:verify:phase3": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/verify-phase3.mjs",
    "db:verify:phase4": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/verify-phase4.mjs",
    "db:verify:access": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/verify-access-guard.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@base-ui/react": "^1.7.0",
    "@date-fns/tz": "^1.5.0",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.39.0",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.28.1",
    "shadcn": "^4.20.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
